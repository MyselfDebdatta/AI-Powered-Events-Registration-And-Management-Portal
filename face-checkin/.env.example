API_URL=http://localhost:8000
# No default credentials. Create a real volunteer account via the admin API
# and supply its credentials at runtime (environment or local .env).
VOLUNTEER_EMAIL=<set-VOLUNTEER_EMAIL>
VOLUNTEER_PASSWORD=<set-VOLUNTEER_PASSWORD>
CAMERA_INDEX=0
MATCH_THRESHOLD=0.4
SYNC_INTERVAL=300
CACHE_DIR=cache
MODEL_NAME=buffalo_l
